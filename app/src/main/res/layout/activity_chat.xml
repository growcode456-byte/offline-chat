<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/chatHeaderAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/splash_logo"
            android:background="@drawable/send_button_bg"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menyambungkan..."
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false" />

    <include
        android:id="@+id/emojiPanel"
        layout="@layout/emoji_picker"
        android:visibility="gone" />

    <!-- INPUT BAR ALA WA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bubble_other"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="bottom"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/wa_input_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnEmoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji_outline"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Emoji" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Ketik pesan"
                android:minHeight="40dp"
                android:maxLines="5"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="#8696A0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_attach_outline"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Lampiran" />

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_camera_outline"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Kamera" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/send_button_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:scaleType="centerInside"
            android:contentDescription="Kirim"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- UI REKAMAN ALA WHATSAPP -->
    <LinearLayout
        android:id="@+id/recordingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC202C33"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- Hapus (Kiri) -->
        <ImageButton
            android:id="@+id/btnCancelRecord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="#E53935" />

        <!-- Timer & Waveform (Tengah) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:layout_marginHorizontal="8dp">

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="12dp" />

            <!-- Garis-garis waveform statis (simulasi) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#8696A0"
                android:scaleType="fitXY" />

        </LinearLayout>

        <!-- Tombol Stop/Kirim (Kanan) -->
        <ImageButton
            android:id="@+id/btnStopRecord"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/send_button_bg"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:scaleType="centerInside" />
    </LinearLayout>
</LinearLayout>
