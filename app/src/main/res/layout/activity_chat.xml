<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/chat_bg">

    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/splash_logo"
            android:background="@drawable/send_button_bg"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menyambungkan..."
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="6dp"
        android:clipToPadding="false" />

    <include
        android:id="@+id/emojiPanel"
        layout="@layout/emoji_picker"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bubble_other"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="bottom"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/wa_input_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnEmoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_emoji"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Emoji" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Ketik pesan"
                android:minHeight="40dp"
                android:maxLines="5"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="#8696A0"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="textMultiLine|textCapSentences"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Lampiran" />

            <ImageButton
                android:id="@+id/btnCamera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="#8696A0"
                android:scaleType="centerInside"
                android:contentDescription="Kamera" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/send_button_bg"
            android:src="@android:drawable/ic_menu_send"
            android:scaleType="centerInside"
            android:contentDescription="Kirim"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
