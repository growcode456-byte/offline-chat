<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#202C33"
    android:padding="20dp">

    <TextView
        android:id="@+id/titleConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hubungkan ke Device"
        android:textColor="#E9EDEF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="20dp" />

    <Button
        android:id="@+id/btnConnectClient"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Sebagai Client (Disarankan)"
        android:textSize="15sp"
        android:backgroundTint="#25D366"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConnectAuto"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Auto (Biarkan Android)"
        android:textSize="15sp"
        android:backgroundTint="#4A90E2"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancelConnect"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Batal"
        android:textSize="15sp"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />
</LinearLayout>
